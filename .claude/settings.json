{
  "permissions": {
    "allow": [
      "Bash(python pipeline/estado.py:*)",
      "Bash(python pipeline/revisar_equipo.py:*)",
      "Bash(python3 pipeline/revisar_equipo.py:*)",
      "Bash(python pipeline/revisar_equipo.py --video:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python pipeline/revisar_equipo.py --hook || python3 pipeline/revisar_equipo.py --hook",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
